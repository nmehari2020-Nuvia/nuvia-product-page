{% comment %}
  Renders a variant's price using Shopify's native money filter — never a
  hardcoded number. Shows a strikethrough compare-at price when it's higher
  than the current price.

  Accepts:
  - variant: a product variant object
{% endcomment %}
{% if variant %}
  {% if variant.compare_at_price > variant.price %}
    <span class="nuvia-price__sale">{{ variant.price | money }}</span>
    <s class="nuvia-price__compare">{{ variant.compare_at_price | money }}</s>
  {% else %}
    <span>{{ variant.price | money }}</span>
  {% endif %}
{% endif %}
