{% comment %}
  Nuvia — The Science
  3-step mechanism explainer. Copy defaults use only compliant wellness
  language (relieves tension, soothes tight muscles, eases stiffness) —
  no treat/cure/prevent/diagnose claims. Media slot is a single
  image_picker (a static photo or an uploaded GIF both work) that
  degrades to a placeholder box when empty.
{% endcomment %}

<div class="nuvia-science">
  <div class="nuvia-science__container">
    <div class="nuvia-heading">
      {% if section.settings.eyebrow != blank %}
        <p class="nuvia-heading__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.headline != blank %}
        <h2 class="nuvia-heading__title">{{ section.settings.headline }}</h2>
      {% endif %}
    </div>

    <div class="nuvia-science__layout">
      <div class="nuvia-science__media">
        {% if section.settings.media != blank %}
          {{ section.settings.media | image_url: width: 1000 | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1000',
            sizes: '(min-width: 750px) 45vw, 100vw',
            alt: section.settings.media_alt | default: section.settings.media.alt
          }}
        {% else %}
          {% render 'nuvia-placeholder', label: 'Mechanism image or GIF', ratio: '4 / 3' %}
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <ol class="nuvia-science__steps">
          {% for block in section.blocks %}
            {% if block.type == 'step' %}
              <li class="nuvia-science__step" {{ block.shopify_attributes }}>
                <span class="nuvia-science__step-number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <div>
                  <h3 class="nuvia-science__step-title">{{ block.settings.title }}</h3>
                  <div class="nuvia-science__step-description">{{ block.settings.description }}</div>
                </div>
              </li>
            {% endif %}
          {% endfor %}
        </ol>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .nuvia-science {
    --nuvia-forest: #2C4A3A;
    --nuvia-sage: #5A8A6A;
    --nuvia-font-headline: 'Playfair Display', Georgia, serif;
    --nuvia-font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;

    background: #ffffff;
    padding: 3rem 0;
    font-family: var(--nuvia-font-body);
  }

  .nuvia-science__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .nuvia-heading {
    text-align: center;
    margin-bottom: 2rem;
  }

  .nuvia-heading__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--nuvia-sage);
    margin: 0 0 0.5rem;
  }

  .nuvia-heading__title {
    font-family: var(--nuvia-font-headline);
    font-weight: 700;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    line-height: 1.2;
    margin: 0;
    color: #1A1A1A;
  }

  .nuvia-heading__title em {
    font-style: italic;
    color: var(--nuvia-forest);
  }

  .nuvia-science__layout {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .nuvia-science__media img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 6px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .nuvia-science__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    counter-reset: none;
  }

  .nuvia-science__step {
    display: flex;
    gap: 1rem;
  }

  .nuvia-science__step-number {
    font-family: var(--nuvia-font-headline);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--nuvia-sage);
    flex: 0 0 auto;
    line-height: 1;
  }

  .nuvia-science__step-title {
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 0 0 0.375rem;
  }

  .nuvia-science__step-description {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #3a3a3a;
  }

  @media (min-width: 750px) {
    .nuvia-science__layout {
      flex-direction: row;
      align-items: center;
      gap: 3rem;
    }

    .nuvia-science__media,
    .nuvia-science__steps {
      flex: 1 1 50%;
      min-width: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nuvia The Science",
  "tag": "section",
  "class": "section-nuvia-science",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "THE SCIENCE"
    },
    {
      "type": "richtext",
      "id": "headline",
      "label": "Headline",
      "default": "<p>How tension actually <em>releases</em></p>"
    },
    {
      "type": "image_picker",
      "id": "media",
      "label": "Mechanism image or GIF"
    },
    {
      "type": "text",
      "id": "media_alt",
      "label": "Media alt text"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Tension builds"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Hours at a desk, on the phone, or looking down at a screen keep the neck and shoulder muscles in a constant, low-grade contraction.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nuvia The Science",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Tension builds",
            "description": "<p>Hours at a desk, on the phone, or looking down at a screen keep the neck and shoulder muscles in a constant, low-grade contraction.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Heat softens the muscle",
            "description": "<p>Gentle, soothing warmth helps tight muscle fibers relax, making them more receptive to pressure.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Kneading works it loose",
            "description": "<p>Rotating nodes apply finger-like pressure to ease everyday stiffness and soothe tight, tense muscles.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
