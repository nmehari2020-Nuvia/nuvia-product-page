{% comment %}
  Nuvia — Footer
  Policy links use Shopify's native shop.policies object — nothing
  hardcoded, and a policy simply doesn't render if it hasn't been set up
  in Settings > Policies. If your theme's global footer (Dawn's
  footer-group) already shows policy links, you likely don't need both —
  feel free to remove this section from the template.
{% endcomment %}

<footer class="nuvia-footer">
  <div class="nuvia-footer__container">
    <p class="nuvia-footer__brand">{{ shop.name }}</p>

    {% liquid
      assign nuvia_has_policies = false
      for policy in shop.policies
        if policy
          assign nuvia_has_policies = true
        endif
      endfor
    %}

    {% if nuvia_has_policies %}
      <ul class="nuvia-footer__links" role="list">
        {% for policy in shop.policies %}
          {% if policy %}
            <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}

    {% if section.settings.guarantee_text != blank %}
      <p class="nuvia-footer__guarantee">{{ section.settings.guarantee_text }}</p>
    {% endif %}

    <p class="nuvia-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
  </div>
</footer>

{% stylesheet %}
  .nuvia-footer {
    --nuvia-forest: #2C4A3A;

    background: var(--nuvia-forest);
    color: rgba(255, 255, 255, 0.85);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    padding: 2.5rem 0;
  }

  .nuvia-footer__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    text-align: center;
  }

  .nuvia-footer__brand {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 1.25rem;
    color: #ffffff;
    margin: 0 0 1rem;
  }

  .nuvia-footer__links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.25rem;
    margin: 0 0 1rem;
    padding: 0;
    font-size: 0.8125rem;
  }

  .nuvia-footer__links a {
    color: inherit;
    text-decoration: none;
  }

  .nuvia-footer__links a:hover {
    text-decoration: underline;
  }

  .nuvia-footer__guarantee {
    font-size: 0.8125rem;
    margin: 0 0 1rem;
  }

  .nuvia-footer__copyright {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nuvia Footer",
  "tag": "section",
  "class": "section-nuvia-footer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Policy links are pulled automatically from Settings > Policies. Set up your Refund, Privacy, Shipping and Terms of Service policies there and they'll appear here."
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee reminder text",
      "default": "90-Day Money-Back Guarantee"
    }
  ],
  "presets": [
    {
      "name": "Nuvia Footer"
    }
  ]
}
{% endschema %}
